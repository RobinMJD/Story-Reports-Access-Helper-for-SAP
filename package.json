{
  "name": "story-reports-access-helper-for-sap",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "A narrowly scoped Microsoft Edge extension that automatically prepares browser access for supported SAP SuccessFactors Story Reports.",
  "license": "MIT",
  "homepage": "https://github.com/RobinMJD/Story-Reports-Access-Helper-for-SAP#readme",
  "repository": {
    "type": "git",
