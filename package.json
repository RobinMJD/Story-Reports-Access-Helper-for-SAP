  },
  "bugs": {
    "url": "https://github.com/RobinMJD/Story-Reports-Access-Helper-for-SAP/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs && node --test tests/*.test.mjs",
    "smoke:edge": "node scripts/smoke-edge.mjs",
    "assets:edge": "node scripts/generate-store-assets.mjs",
    "package:edge": "node scripts/package-edge.mjs",
    "verify:edge-package": "node scripts/verify-edge-package.mjs",
